   ],
   "source": [
    "fig = plt.figure(figsize=(16,10))\n",
    "\n",
    "# Condensing the plots\n",
    "fig.subplots_adjust(hspace=0.0, wspace=0.0)\n",
    "\n",
    "\n",
    "ax1 = fig.add_subplot(221)\n",
    "ax1.scatter(data['X'],data['Y'])\n",
    "\n",
    "ax2 = fig.add_subplot(222)\n",
    "ax2.scatter(data['Y'],data['Z'])\n",
    "\n",
    "ax3 = fig.add_subplot(223)\n",
    "ax3.scatter(data['X'],data['Z'])\n",
    "\n",
    "ax4 = fig.add_subplot(224)\n",
    "ax4.scatter(data['Rgc'],data['Z'])\n",
    "\n",
    "# Removing unneeded tick axis\n",
    "ax1.set_xticks([])\n",
    "ax2.set_yticks([])\n",
    "ax2.set_xticks([])\n",
    "ax4.set_yticks([])\n",
    "\n",
    "# AND CAN SAVE YOUR FIGURES  (jpeg, pdf)!   \n",
    "plt.savefig(\"CG20_tmp.jpeg\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Exercise 1\n",
    "\n",
    "Now a plot with RAdeg vs. DEdeg with size scaled by r50 and color coded by the log10 of nbstars07.  Note make it as readable as possible!"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1600x1000 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "import numpy as np\n",
    "from matplotlib import pyplot as plt\n",
    "\n",
    "data = np.genfromtxt(\"CG20.csv\", delimiter=\",\", names=True)\n",
    "\n",
    "fig = plt.figure(figsize=(16,10))\n",
    "ax = fig.add_subplot(111)\n",
    "\n",
    "image = ax.scatter(data['RAdeg'], data['DEdeg'],\n",
    "                   s=200*data['r50'],\n",
    "                   c=np.log10(data['nbstars07']),\n",
    "                   cmap='viridis',\n",
    "                   alpha=0.5)\n",
    "\n",
    "bar = fig.colorbar(image)\n",
    "bar.set_label('log10(Number of Stars)', size=15)\n",
    "\n",
    "ax.set_xlabel('RAdeg', size=20)\n",
    "ax.set_ylabel('DEdeg', size=20)\n",
    "\n",
    "ax.xaxis.set_tick_params(labelsize=15)\n",
    "ax.yaxis.set_tick_params(labelsize=15)\n",
    "\n",
    "plt.show()\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "collapsed": true,
    "jupyter": {
     "outputs_hidden": true
    }
   },
   "source": [
    "### Exercise 2\n",
    "\n",
    "Panel 1) GLON vs. GLAT\n",
    "\n",
    "Panel 2) pmRA* vs pmDE\n",
    "\n",
    "Panel 3) Rgc vs. Z\n",
    "\n",
    "panel 4) AgeNN vs. DistPc\n",
    "\n",
    "Give the sizes of the points by 'r50' and color the points by AgeNN. \n",
    "\n",
    "**Make sure to label ALL your axis and include a colorbar.**<br>\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1600x1000 with 5 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "import numpy as np\n",
    "from matplotlib import pyplot as plt\n",
    "\n",
    "# Read the data\n",
    "data = np.genfromtxt(\"CG20.csv\", delimiter=\",\", names=True)\n",
    "\n",
    "# Create the figure and four panels\n",
    "fig = plt.figure(figsize=(16,10))\n",
    "\n",
    "ax1 = fig.add_subplot(221)\n",
    "ax2 = fig.add_subplot(222)\n",
    "ax3 = fig.add_subplot(223)\n",
    "ax4 = fig.add_subplot(224)\n",
    "\n",
    "# Panel 1\n",
    "image = ax1.scatter(data['GLON'], data['GLAT'],\n",
    "                    s=200*data['r50'],\n",
    "                    c=data['AgeNN'],\n",
    "                    cmap='viridis', alpha=0.5)\n",
    "\n",
    "# Panel 2\n",
    "ax2.scatter(data['pmRA'], data['pmDE'],\n",
    "            s=200*data['r50'],\n",
    "            c=data['AgeNN'],\n",
    "            cmap='viridis', alpha=0.5)\n",
    "\n",
    "# Panel 3\n",
    "ax3.scatter(data['Rgc'], data['Z'],\n",
    "            s=200*data['r50'],\n",
    "            c=data['AgeNN'],\n",
    "            cmap='viridis', alpha=0.5)\n",
    "\n",
    "# Panel 4\n",
    "ax4.scatter(data['AgeNN'], data['DistPc'],\n",
    "            s=200*data['r50'],\n",
    "            c=data['AgeNN'],\n",
    "            cmap='viridis', alpha=0.5)\n",
    "\n",
    "# Label all axes\n",
    "ax1.set_xlabel('GLON')\n",
    "ax1.set_ylabel('GLAT')\n",
    "\n",
    "ax2.set_xlabel('pmRA*')\n",
    "ax2.set_ylabel('pmDE')\n",
    "\n",
    "ax3.set_xlabel('Rgc')\n",
    "ax3.set_ylabel('Z')\n",
    "\n",
    "ax4.set_xlabel('AgeNN')\n",
    "ax4.set_ylabel('DistPc')\n",
    "\n",
    "# Colorbar\n",
    "bar = fig.colorbar(image, ax=[ax1, ax2, ax3, ax4])\n",
    "bar.set_label('AgeNN (log10 Age)')\n",
    "\n",
    "plt.show()\n"
   ]
  },
  {
